{
  "name": "secure-ls2",
  "version": "2.2.0",
  "description": "Secure localStorage/sessionStorage data with high level of encryption and data compression",
  "main": "./dist/secure-ls2.js",
  "module": "./dist/secure-ls2.esm.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./types/secure-ls.d.mts",
        "default": "./dist/secure-ls2.esm.mjs"
      },
      "require": {
        "types": "./types/secure-ls.d.ts",
        "default": "./dist/secure-ls2.js"
      }
    }
  },
  "browser": "./dist/secure-ls2.js",
  "typings": "./types/secure-ls.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "prebuild": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "yarn build-dev && yarn build-prod",
    "build-dev": "webpack --mode=development",
    "build-prod": "webpack --mode=production",
    "lint": "eslint src/*.js --fix",
    "prepare": "husky",
    "prettier": "prettier -w \"{src,test,example}/**/*.js\" \"*.md\"",
    "test": "jest --runInBand --colors --errorOnDeprecated",
    "test:dev": "jest --watch --runInBand --debug --colors --errorOnDeprecated",
    "test:prod": "jest --runInBand --colors --errorOnDeprecated",
    "test:coverage": "jest --coverage --coverageDirectory=coverage && cat ./coverage/lcov.info",
    "prepublishOnly": "yarn run build",
    "release": "npx bumpp --commit --tag --push && npm publish"
  },
  "lint-staged": {
    "**/*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/lz-string": "^1.5.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "semver": "^7.8.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuc656/secure-ls.git"
  },
  "keywords": [
    "secure-ls",
    "localStorage",
    "encryption",
    "compression",
    "webpack",
    "es6",
    "umd",
    "commonjs"
  ],
  "author": "wuc656, Varun Malhotra",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wuc656/secure-ls/issues"
  },
  "homepage": "https://github.com/wuc656/secure-ls",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@4.18.0",
  "engineStrict": true,
  "allowScripts": {
    "unrs-resolver@1.11.1": true
  }
}
